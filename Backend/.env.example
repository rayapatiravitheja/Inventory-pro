# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
TIMEZONE=Asia/Kolkata

# Database (MongoDB Atlas or Local connection string)
MONGODB_URI=mongodb://127.0.0.1:27017

# Authentication & JWT Secrets (Generate strong random secrets for production)
ACCESS_TOKEN_SECRET=your_super_secret_jwt_access_token_key_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_super_secret_jwt_refresh_token_key_here
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary Storage (Product Images & Avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer Gmail SMTP for OTPs, Return Alerts & Stock Digests)
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD="your_gmail_app_specific_password"
EMAIL_USER=your_email@gmail.com
ADMIN_EMAIL=admin_notifications@yourdomain.com

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
